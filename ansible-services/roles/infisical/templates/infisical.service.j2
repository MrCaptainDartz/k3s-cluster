[Unit]
Description=Infisical Secrets Service (Podman Compose)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ infisical_dir }}
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
Environment=DOCKER_HOST=unix:///run/user/%U/podman/podman.sock
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/podman-compose up -d --remove-orphans
ExecStop=/usr/bin/podman-compose down
ExecReload=/usr/bin/podman-compose restart

[Install]
WantedBy=default.target
