# Infisical Environment Configuration (Ansible Managed)
NODE_ENV=production
PORT=8080

# Cryptographic Keys (Required for encryption and JWT signing)
ENCRYPTION_KEY={{ resolved_infisical_encryption_key }}
AUTH_SECRET={{ resolved_infisical_auth_secret }}

# JWT Token Lifetimes (Production Hardening)
JWT_AUTH_LIFETIME={{ infisical_jwt_auth_lifetime | default('15m') }}
JWT_REFRESH_LIFETIME={{ infisical_jwt_refresh_lifetime | default('24h') }}
JWT_SERVICE_LIFETIME={{ infisical_jwt_service_lifetime | default('1h') }}

# PostgreSQL Credentials
POSTGRES_USER={{ infisical_db_user }}
POSTGRES_PASSWORD={{ resolved_infisical_db_password }}
POSTGRES_DB={{ infisical_db_name }}

# Redis Credentials
REDIS_PASSWORD={{ resolved_infisical_redis_password }}

# Database & Redis Connection URIs
DB_CONNECTION_URI=postgres://{{ infisical_db_user }}:{{ resolved_infisical_db_password }}@db:5432/{{ infisical_db_name }}
REDIS_URL=redis://:{{ resolved_infisical_redis_password }}@redis:6379

# Site URL & CORS Configuration
SITE_URL={{ 'https://' + traefik_infisical_domain if (traefik_enabled | default(true)) else 'http://' + ansible_host + ':' + (infisical_port | string) }}
CORS_ALLOWED_ORIGINS=["{{ 'https://' + traefik_infisical_domain if (traefik_enabled | default(true)) else 'http://' + ansible_host + ':' + (infisical_port | string) }}"]

# Network Security & SSRF Protection
ALLOW_INTERNAL_IP_CONNECTIONS=false
SAFE_REQUEST_FORCE_DIRECT_EGRESS=true

# Telemetry
OTEL_TELEMETRY_COLLECTION_ENABLED=false
TELEMETRY_ENABLED=false
