---
services:
  forgejo-db:
    image: docker.io/library/postgres:16-alpine
    container_name: forgejo-db
    restart: unless-stopped
    env_file:
      - .env
    environment:
      POSTGRES_DB: "{{ forgejo_db_name }}"
      POSTGRES_USER: "{{ forgejo_db_user }}"
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}"
    volumes:
      - ./data/postgres:/var/lib/postgresql/data:Z,U
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ forgejo_db_user }} -d {{ forgejo_db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: "{{ forgejo_log_driver | default('json-file') }}"
      options:
        max-size: "{{ forgejo_log_max_size | default('500m') }}"
        max-file: "{{ forgejo_log_max_file | default('3') }}"
    networks:
      - forgejo-network

  forgejo:
    image: codeberg.org/forgejo/forgejo:{{ forgejo_version }}
    container_name: forgejo
    restart: unless-stopped
    depends_on:
      forgejo-db:
        condition: service_healthy
    env_file:
      - .env
    environment:
      USER_UID: 1000
      USER_GID: 1000
      FORGEJO__database__DB_TYPE: postgres
      FORGEJO__database__HOST: forgejo-db:5432
      FORGEJO__database__NAME: "{{ forgejo_db_name }}"
      FORGEJO__database__USER: "{{ forgejo_db_user }}"
      FORGEJO__database__PASSWD: "${POSTGRES_PASSWORD}"
      FORGEJO__server__DOMAIN: "{{ traefik_forgejo_domain | default(ansible_host) }}"
      FORGEJO__server__SSH_DOMAIN: "{{ traefik_forgejo_domain | default(ansible_host) }}"
      FORGEJO__server__HTTP_ADDR: "0.0.0.0"
      FORGEJO__server__HTTP_PORT: 3000
      FORGEJO__server__ROOT_URL: "{{ 'https://' + traefik_forgejo_domain + '/' if (traefik_enabled | default(true)) else 'http://' + ansible_host + ':' + (forgejo_http_port | string) + '/' }}"
      FORGEJO__server__SSH_PORT: {{ forgejo_ssh_port }}
      FORGEJO__service__DISABLE_REGISTRATION: "{{ forgejo_disable_registration | bool | lower }}"
      FORGEJO__service__REQUIRE_SIGNIN_VIEW: true
      FORGEJO__security__INSTALL_LOCK: true
    volumes:
      - ./data/forgejo:/data:Z,U
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "{{ forgejo_ssh_port }}:22"
    logging:
      driver: "{{ forgejo_log_driver | default('json-file') }}"
      options:
        max-size: "{{ forgejo_log_max_size | default('500m') }}"
        max-file: "{{ forgejo_log_max_file | default('3') }}"
    networks:
      - forgejo-network
      - services-network

networks:
  forgejo-network:
    driver: bridge
  services-network:
    name: services-network
    external: true
