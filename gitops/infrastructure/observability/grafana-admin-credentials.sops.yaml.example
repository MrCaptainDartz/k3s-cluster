# EXAMPLE / TEMPLATE — documentation only. NOT referenced in kustomization.yaml,
# so ArgoCD does NOT apply it. The real secret lives in
# grafana-admin-credentials.sops.yaml, which is sops-encrypted — its stringData is an
# opaque ENC[] blob, so anyone cloning the repo to deploy their own cluster cannot see
# what to put inside. This file shows the cleartext structure.
#
# To create your own encrypted secret from this template:
#   1. cp grafana-admin-credentials.sops.yaml.example grafana-admin-credentials.sops.yaml
#   2. sops --encrypt --in-place grafana-admin-credentials.sops.yaml
#   3. sops edit grafana-admin-credentials.sops.yaml
#      fill admin-password, save -> re-encrypted + MAC
#   4. ensure `- grafana-admin-credentials.sops.yaml` is listed under
#      kustomization.yaml resources (it already is in this repo)
#
# This SopsSecret materializes Secret `grafana-admin-credentials` in `monitoring`
# with keys `admin-user` / `admin-password`, which kube-prometheus-stack reads via
# grafana.admin.existingSecret (see kps-values.yaml). It keeps the admin password out
# of plaintext helm values (replaces the previous grafana.adminPassword: "admin").
# Key names `admin-user` / `admin-password` match the grafana helm chart defaults
# (override via grafana.admin.userKey / .passwordKey if you rename them).
apiVersion: addons.projectcapsule.dev/v1alpha1
kind: SopsSecret
metadata:
  name: grafana-admin-credentials
  namespace: monitoring
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
spec:
  secrets:
    - name: grafana-admin-credentials
      stringData:
        admin-user: admin
        admin-password: REPLACE_WITH_GRAFANA_ADMIN_PASSWORD