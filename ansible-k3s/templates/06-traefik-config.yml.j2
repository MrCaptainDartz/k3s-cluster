---
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    deployment:
      kind: DaemonSet
    providers:
      kubernetesIngress:
        publishedService:
          enabled: true
    tolerations:
      - key: "node-role.kubernetes.io/control-plane"
        operator: "Exists"
        effect: "NoSchedule"
      - key: "node-role.kubernetes.io/master"
        operator: "Exists"
        effect: "NoSchedule"
    globalArguments: []
    ports:
      web:
        http:
          redirections:
            entryPoint:
              to: websecure
              scheme: https
              permanent: true
      traefik:
        expose:
          default: true
        exposedPort: 8080
      # Metrics :9100 exposed on LB so 65- ServiceMonitor scrapes port "metrics"; safe (cluster behind firewall, LAN-only).
      metrics:
        expose:
          default: true
        exposedPort: 9100
    ingressRoute:
      dashboard:
        enabled: true
    service:
      annotations:
        metallb.io/loadBalancerIPs: "{{ traefik_lb_ip }}"
    # Access logs — forensics only (errors + slow requests), NOT full traffic.
    # Traefik filters are OR-connected (keepAccessLog in pkg/middlewares/accesslog/logger.go): a request
    # is logged if its status code is in `statuscodes` OR its duration exceeds `minduration`. Normal 2xx/3xx
    # fast traffic is NOT logged -> ~0 volume to Loki. Throughput/latency VOLUME comes from Traefik metrics
    # (:9100, already scraped by 65-), not from logs — full per-request logging is untenable at 10 Gb/s
    # (would fill the 10 Gi Loki PVC in minutes and pit Alloy's CPU against Traefik's TLS termination).
    # Alloy tails Traefik's stdout via the existing pod-log pipeline (file-based, no kube-api, no NP change).
    # bufferingSize batches N entries before flush -> fewer I/O syscalls (perf at high rps). `enabled` is a
    # bare bool via ternary (not a Jinja if-block) to dodge the trim_blocks+valuesContent newline trap.
    logs:
      access:
        enabled: {{ traefik_access_log_enabled | bool | ternary('true', 'false') }}
        format: {{ traefik_access_log_format | to_json }}
        bufferingSize: {{ traefik_access_log_buffering_size | int }}
        filters:
          statuscodes: {{ traefik_access_log_status_codes | to_json }}
          minduration: {{ traefik_access_log_min_duration | to_json }}