---
# external-dns namespace: deny-all + targeted egress (API server, DNS, DNS-provider APIs :443).
# One NP set covers all provider instances in the namespace (Infomaniak/OVH/Cloudflare all call a public
# :443 API). The Infomaniak webhook sidecar talks to the main external-dns container over localhost
# (intra-pod, not enforced by kube-router). Mirror of 25-certmanager-network-policies.
{% if externaldns_enabled | bool %}
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny-all
  namespace: external-dns
spec:
  podSelector: {}
  policyTypes:
    - Ingress
    - Egress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-egress-kubeapi
  namespace: external-dns
spec:
  podSelector: {}
  policyTypes:
    - Egress
  egress:
    - to:
        - ipBlock:
            cidr: {{ node_cidr }}
      ports:
        - protocol: TCP
          port: 6443
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-egress-dns
  namespace: external-dns
spec:
  podSelector: {}
  policyTypes:
    - Egress
  egress:
    # Resolve the provider API hostname (api.infomaniak.com / eu.api.ovh.com / api.cloudflare.com).
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-egress-dns-providers
  namespace: external-dns
spec:
  podSelector: {}
  policyTypes:
    - Egress
  egress:
    # DNS provider APIs are public :443 (any IP) — one rule covers Infomaniak/OVH/Cloudflare.
    - to:
        - ipBlock:
            cidr: 0.0.0.0/0
      ports:
        - protocol: TCP
          port: 443
{% if observability_enabled | bool %}
---
# Prometheus scrape allow (only if observability): external-dns metrics :7472 + Infomaniak webhook :8080.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-ingress-from-prometheus
  namespace: external-dns
spec:
  podSelector: {}
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ observability_namespace }}
          podSelector:
            matchLabels:
              app.kubernetes.io/name: prometheus
      ports:
        - protocol: TCP
          port: 7472
        - protocol: TCP
          port: 8080
{% endif %}
{% endif %}