---
apiVersion: v1
kind: Namespace
metadata:
  name: argocd
  labels:
    pod-security.kubernetes.io/enforce: baseline
---
apiVersion: v1
kind: Secret
metadata:
  name: argocd-repo-creds
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
data:
  type: "{{ 'git' | b64encode }}"
  url: "{{ argocd_git_repository_url | b64encode }}"
  sshPrivateKey: "{{ argocd_git_deploy_key | b64encode }}"
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: argocd
  namespace: kube-system
spec:
  chart: argo-cd
  repo: "{{ argocd_helm_repo }}"
  version: "{{ argocd_helm_version }}"
  targetNamespace: argocd
  valuesContent: |-
    global:
      domain: "{{ argocd_domain }}"
    server:
      extraArgs:
        - --insecure
      ingress:
        enabled: true
        ingressClassName: traefik
        annotations:
          # Use default Traefik cert because cert-manager is not yet deployed!
          traefik.ingress.kubernetes.io/router.tls: "true"
        hosts:
          - "{{ argocd_domain }}"
    configs:
      cm:
        timeout.reconciliation: 10s
        kustomize.buildOptions: "--enable-helm"
        resource.customizations.health.argoproj.io_Application: |
          hs = {}
          hs.status = "Progressing"
          hs.message = ""
          if obj.status ~= nil then
            if obj.status.health ~= nil then
              hs.status = obj.status.health.status
              if obj.status.health.message ~= nil then
                hs.message = obj.status.health.message
              end
            end
          end
          return hs
        # resource.exclusions: override the argo-cd chart default. The default
        # excludes Endpoints (core "") to reduce watched events, but kube-prometheus-
        # stack creates MANUAL Endpoints (no selector) for the k3s control-plane metrics
        # ServiceMonitors (kubeScheduler/kubeControllerManager/kubeProxy/kubeEtcd point at
        # the control-plane node IPs). With Endpoints excluded ArgoCD never applies them,
        # the Services have no endpoints, and the 4 control-plane targets stay down
        # (KubeSchedulerDown/KubeControllerManagerDown/KubeProxyDown fire). EndpointSlice
        # (still excluded) is auto-managed by the endpoint controller; only manual
        # Endpoints need ArgoCD to manage them. All other default exclusions preserved.
        resource.exclusions: |
          - apiGroups:
              - discovery.k8s.io
            kinds:
              - EndpointSlice
          - apiGroups:
              - coordination.k8s.io
            kinds:
              - Lease
          - apiGroups:
              - authentication.k8s.io
              - authorization.k8s.io
            kinds:
              - SelfSubjectReview
              - TokenReview
              - LocalSubjectAccessReview
              - SelfSubjectAccessReview
              - SelfSubjectRulesReview
              - SubjectAccessReview
          - apiGroups:
              - certificates.k8s.io
            kinds:
              - CertificateSigningRequest
          - apiGroups:
              - cert-manager.io
            kinds:
              - CertificateRequest
          - apiGroups:
              - cilium.io
            kinds:
              - CiliumIdentity
              - CiliumEndpoint
              - CiliumEndpointSlice
          - apiGroups:
              - kyverno.io
              - reports.kyverno.io
              - wgpolicyk8s.io
            kinds:
              - PolicyReport
              - ClusterPolicyReport
              - EphemeralReport
              - ClusterEphemeralReport
              - AdmissionReport
              - ClusterAdmissionReport
              - BackgroundScanReport
              - ClusterBackgroundScanReport
              - UpdateRequest
