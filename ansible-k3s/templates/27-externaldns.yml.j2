---
# ExternalDNS — one instance per DNS cred in certmanager_dns_credentials, each managing that cred's
# match_domains. Reuses the SAME creds as cert-manager (no secret duplication — just a namespace copy,
# Secrets being namespace-scoped). Gated on externaldns_enabled.
#   Infomaniak -> NOT native; community webhook sidecar ghcr.io/m0nsterrr/external-dns-webhook-infomaniak
#                 via the official chart's provider.name: webhook + provider.webhook stanza.
#   OVH        -> native provider; creds via env (OVH_APPLICATION_KEY/SECRET/CONSUMER_KEY/ENDPOINT).
#   Cloudflare -> native provider; creds via env (CF_API_TOKEN).
# Each instance: domainFilter = cred.match_domains, unique txtOwnerId, policy sync + txt registry (sync
# only deletes records it owns — manual records safe). dry-run first (extraArgs --dry-run + webhook DRY_RUN),
# flip externaldns_dry_run to false after verifying the logs. A records point at the Traefik LB IP
# (Traefik publishes its LB IP as the Ingress status via 12-traefik-config ingressendpoint.publishedservice).
# Local-only apps: a hostless Ingress, a host outside domainFilters, or the exclude annotation -> no record.
{% if externaldns_enabled | bool %}
{% for cred in certmanager_dns_credentials %}
---
apiVersion: v1
kind: Secret
metadata:
  name: externaldns-{{ cred.name }}
  namespace: external-dns
type: Opaque
stringData:
{% if cred.provider == "infomaniak" %}
  api-token: "{{ cred.token }}"
{% elif cred.provider == "ovh" %}
  applicationKey: "{{ cred.application_key }}"
  applicationSecret: "{{ cred.application_secret }}"
  applicationConsumerKey: "{{ cred.consumer_key }}"
{% elif cred.provider == "cloudflare" %}
  token: "{{ cred.token }}"
{% endif %}
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: externaldns-{{ cred.name }}
  namespace: kube-system
spec:
  repo: "{{ externaldns_chart_repo }}"
  chart: external-dns
  version: "{{ externaldns_chart_version }}"
  targetNamespace: external-dns
  valuesContent: |-
    fullnameOverride: "externaldns-{{ cred.name }}"
    image:
      tag: {{ externaldns_image_tag | to_json }}
    logLevel: info
    namespaced: false
    rbac:
      create: true
    sources:
      - ingress
      - service
    policy: {{ externaldns_policy | to_json }}
    registry: txt
    txtOwnerId: {{ ("k3s-externaldns-" ~ cred.name) | to_json }}
    domainFilters:
{% for d in cred.match_domains %}
      - {{ d | to_json }}
{% endfor %}
{% if (externaldns_dry_run | bool) or (externaldns_default_targets is defined and externaldns_default_targets) %}
    extraArgs:
{% if externaldns_dry_run | bool %}
      - --dry-run
{% endif %}
{% if externaldns_default_targets is defined and externaldns_default_targets %}
      - --default-targets={{ externaldns_default_targets }}
      - --force-default-targets
{% endif %}
{% endif %}
{% if cred.provider == "infomaniak" %}
    provider:
      name: webhook
      webhook:
        image:
          repository: ghcr.io/m0nsterrr/external-dns-webhook-infomaniak
          tag: {{ externaldns_webhook_image_tag | to_json }}
          pullPolicy: IfNotPresent
        env:
          - name: INFOMANIAK_API_TOKEN
            valueFrom:
              secretKeyRef:
                name: externaldns-{{ cred.name }}
                key: api-token
          - name: SERVER_PORT
            value: "8888"
          - name: METRICS_PORT
            value: "8080"
          - name: DRY_RUN
            value: {{ externaldns_dry_run | bool | ternary("true", "false") | to_json }}
{% elif cred.provider == "ovh" %}
    provider:
      name: ovh
    env:
      - name: OVH_APPLICATION_KEY
        valueFrom:
          secretKeyRef:
            name: externaldns-{{ cred.name }}
            key: applicationKey
      - name: OVH_APPLICATION_SECRET
        valueFrom:
          secretKeyRef:
            name: externaldns-{{ cred.name }}
            key: applicationSecret
      - name: OVH_CONSUMER_KEY
        valueFrom:
          secretKeyRef:
            name: externaldns-{{ cred.name }}
            key: applicationConsumerKey
      - name: OVH_ENDPOINT
        value: {{ cred.endpoint | to_json }}
{% elif cred.provider == "cloudflare" %}
    provider:
      name: cloudflare
    env:
      - name: CF_API_TOKEN
        valueFrom:
          secretKeyRef:
            name: externaldns-{{ cred.name }}
            key: token
{% endif %}
{% endfor %}
{% endif %}