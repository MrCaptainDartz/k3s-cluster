---
# K3s — Core Configuration

k3s_api_port: "6443"

# K3s version. Pinned to avoid silent, breaking changes.
k3s_release_version: "v1.36.2+k3s1"

# Use embedded etcd as the datastore (recommended for 3 control planes)
k3s_etcd_datastore: true

# Scheduled etcd snapshots (stored under /var/lib/rancher/k3s/server/db/snapshots/).
k3s_etcd_snapshot_cron: "0 */6 * * *"   # every 6 hours
k3s_etcd_snapshot_retention: "28"       # ~7 days at 6h intervals

# Enable privilege escalation for K3s installation
k3s_become: true

# Address used by nodes to join the cluster (set to kube-vip VIP)
k3s_registration_address: "{{ k3s_vip }}"

# K3s — Server (Control Plane) Configuration

# Components to disable in K3s (Traefik is kept and customized).
k3s_disabled_components:
  - servicelb
  - local-storage

k3s_server:
  disable: "{{ k3s_disabled_components }}"
  tls-san:
    - "{{ k3s_vip }}"
  disable-cloud-controller: true
  # 0600 ensures /etc/rancher/k3s/k3s.yaml is not world/group-readable.
  write-kubeconfig-mode: "0600"
  flannel-backend: "host-gw"
  etcd-snapshot-schedule-cron: "{{ k3s_etcd_snapshot_cron }}"
  etcd-snapshot-retention: "{{ k3s_etcd_snapshot_retention }}"
  # Expose control-plane metrics for Prometheus (KPS kubeEtcd/kubeScheduler/kubeControllerManager).
  # K3s binds them to 127.0.0.1 by default; bind-address=0.0.0.0 makes them scrapable. etcd on :2381
  # (HTTP). Applied on next k3s restart (the role restarts k3s on config change).
  etcd-expose-metrics: true
  kube-controller-manager-arg:
    - "bind-address=0.0.0.0"
  kube-scheduler-arg:
    - "bind-address=0.0.0.0"
  # kube-proxy metrics on :10249 (HTTP). In-process on every node -> same control-plane IPs.
  kube-proxy-arg:
    - "metrics-bind-address=0.0.0.0"
  # kube-apiserver audit logging (gated on audit_enabled). Empty list when disabled -> no arg passed.
  # The policy file is dropped by a site.yml pre_task BEFORE the role restarts the apiserver.
  # Audit logs are shipped to Loki by Alloy (deployed via GitOps in gitops/infrastructure/observability).
  kube-apiserver-arg: "{{ audit_enabled | bool | ternary(audit_apiserver_args, []) }}"

# kube-apiserver audit logging (optional) — forensics: who did what to the API
# Enable API server audit logging (writes to /var/log/k3s/audit.log)
# Restart safety: run playbook with --forks 1 to maintain etcd quorum.
audit_enabled: false
audit_policy_path: "/etc/rancher/k3s/audit-policy.yaml"
audit_log_path: "/var/log/k3s/audit.log"
audit_log_maxage: 7      # days of rotated audit logs to keep
audit_log_maxbackup: 3   # number of rotated audit logs to retain
audit_log_maxsize: 10    # MB per audit log file before rotation
audit_apiserver_args:
  - "audit-policy-file={{ audit_policy_path }}"
  - "audit-log-path={{ audit_log_path }}"
  - "audit-log-format=json"
  - "audit-log-maxage={{ audit_log_maxage }}"
  - "audit-log-maxbackup={{ audit_log_maxbackup }}"
  - "audit-log-maxsize={{ audit_log_maxsize }}"

# CoreDNS — HA replica count
# Desired CoreDNS replica count (asserted via post_tasks since K3s doesn't manage it).
coredns_replicas: 3

# kube-vip — Control Plane Virtual IP

# Virtual IP address for the K3s API server (must be free on the network)
k3s_vip: "192.168.1.10"

# Network interface for kube-vip. Left empty ("") to auto-resolve based on node_cidr.
k3s_vip_interface: ""

# kube-vip container image and version
kube_vip_image: "ghcr.io/kube-vip/kube-vip"
kube_vip_version: "v1.2.1"

# CIDR of the node network (control planes + workers).
node_cidr: "192.168.1.0/24"

# Pod CIDR (k3s cluster-cidr).
cluster_cidr: "10.42.0.0/16"

# MetalLB — LoadBalancer

# MetalLB version to install
metallb_version: "v0.16.1"

# IP range for MetalLB (same L2 as nodes, no overlap with DHCP/static IPs)
metallb_ip_range: "192.168.1.150-192.168.1.199"

# Name of the MetalLB IP pool
metallb_pool_name: "default-pool"

# Traefik (K3s-packaged Ingress Controller)
# Traefik is customized via a HelmChartConfig (templates/06-traefik-config.yml.j2).

# Fixed MetalLB IP for Traefik's LoadBalancer Service.
traefik_lb_ip: "192.168.1.199"

# Traefik access logs — logs errors and slow requests only.
traefik_access_log_enabled: false         # off by default; flip to true once observability is deployed via GitOps
traefik_access_log_format: json           # json (stable parse in Loki) | common | genericCLF
traefik_access_log_status_codes: "400-599" # log these status codes (range syntax supported)
traefik_access_log_min_duration: "500ms"  # ...OR log requests slower than this
traefik_access_log_buffering_size: 100    # batch N entries before flush (fewer I/O syscalls, perf)

gitops_root_app_enabled: true

# GitOps Secrets (Age Key & ArgoCD Repo)

# ArgoCD Installation
argocd_helm_repo: "https://argoproj.github.io/argo-helm"
argocd_helm_version: "10.2.1"
argocd_domain: "argocd.yourdomain.com"

# Age private key for SOPS Operator decryption (SECRET)
# Generate with: age-keygen -o age.key
age_private_key: "AGE-SECRET-KEY-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# SSH Deploy Key or Token for ArgoCD to access the private GitOps repository (SECRET)
# TODO: Create a deploy key on your GitHub/GitLab and place the private key below.
argocd_git_repository_url: "git@github.com:YOUR_REPO/k3s-cluster.git"
argocd_git_deploy_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAAAAtzc2gtZW
  ...
  -----END OPENSSH PRIVATE KEY-----

# K3s — Auto-deployed Manifests

# Manifests downloaded from URLs and placed in /var/lib/rancher/k3s/server/manifests/
k3s_server_manifests_urls:
  - url: "https://raw.githubusercontent.com/metallb/metallb/{{ metallb_version }}/config/manifests/metallb-native.yaml"
    filename: 03-metallb-native.yaml

# Manifests rendered from Jinja2 templates and placed in /var/lib/rancher/k3s/server/manifests/
k3s_server_manifests_templates:
  - 01-kube-vip-rbac.yml.j2
  - 02-kube-vip-daemonset.yml.j2
  - 04-metallb-config.yml.j2
  - 05-network-policies.yml.j2
  - 06-traefik-config.yml.j2
  - 07-pod-security.yml.j2
  - 08-sops-operator.yml.j2
  - 09-argocd.yml.j2
  - 10-coredns-pdb.yml.j2
